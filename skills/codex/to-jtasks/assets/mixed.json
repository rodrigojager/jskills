      "initial": {"program": "cargo", "args": ["test", "--tests"], "cwd": ".", "deadline_ms": 180000},
      "repair_task": "T2"
    },
    {
      "id": "package",
      "stage": {"kind": "final", "tasks": ["T1", "T2"]},
      "depends_on": [{"kind": "operation", "id": "integration"}],
      "required": true,
      "revision": "authored-r1",
      "inputs": ["Cargo.toml", "src", "tests"],
      "initial": {"program": "cargo", "args": ["package", "--no-verify"], "cwd": ".", "deadline_ms": 180000},
      "repair_task": "T2"
    }
  ]
