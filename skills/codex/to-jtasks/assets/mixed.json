  },
  "tasks": [
    {
      "id": "T1",
      "title": "Implement the first deliverable",
      "requirements": ["R1"],
      "admission": {"resources": ["path:src/lib.rs"]},
      "context": {"requirements": ["Deliver the selected behavior in src/lib.rs."], "limits": ["Preserve existing work."]},
      "executor": {"kind": "fixture", "outcome": "completed", "summary": "Example first deliverable."}
    },
    {
      "id": "T2",
      "title": "Integrate the deliverable",
      "requirements": ["R2"],
      "depends_on": ["T1"],
      "admission": {"resources": ["path:src/main.rs"]},
      "context": {"requirements": ["Integrate the public behavior."], "dependency_artifacts": ["src/lib.rs from T1"], "limits": ["Preserve existing work."]},
      "executor": {"kind": "fixture", "outcome": "completed", "summary": "Example integration deliverable."}
    }
  ],
  "operations": [
    {
      "id": "toolchain",
      "stage": {"kind": "prerequisite", "consumers": ["T1", "T2"]},
      "required": true,
      "revision": "authored-r1",
      "inputs": ["Cargo.toml"],
      "initial": {"program": "cargo", "args": ["--version"], "cwd": ".", "deadline_ms": 30000}
    },
    {
      "id": "focused",
      "stage": {"kind": "task", "task": "T1"},
      "required": true,
      "revision": "authored-r1",
      "inputs": ["Cargo.toml", "src/lib.rs"],
      "initial": {"program": "cargo", "args": ["check", "--lib"], "cwd": ".", "deadline_ms": 120000},
      "repair_task": "T1"
    },
    {
      "id": "integration",
      "stage": {"kind": "group", "tasks": ["T1", "T2"]},
      "required": true,
      "revision": "authored-r1",
