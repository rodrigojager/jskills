  "context": {
    "brief": "Schema demonstration for a Rust checkout. Ask each real plan's policy explicitly; review these Cargo invocations and replace fixture executors before authorizing work.",
    "configuration": ["Example policy: judgment plus selected required checks, mixed placement."],
