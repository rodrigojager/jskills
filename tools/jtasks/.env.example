# Variable names only. Real values live in the container's _secrets/.env.
# EXAMPLE_API_KEY=
# Bounded controller shutdown: graceful request, then forced scope observation.
# JTASKS_SHUTDOWN_GRACE_MS=10000
# JTASKS_SHUTDOWN_FORCE_MS=5000
# Stable GitHub release source for explicit update checks/installation.
# JTASKS_UPDATE_REPOSITORY=owner/repo
